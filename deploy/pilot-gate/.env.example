# Copy to ~/register-auth/.env (outside git), then fill in the values.
# chmod 600 ~/register-auth/.env
#
# Clerk domain of the instance (the "frontend API" host, without https://).
CLERK_DOMAIN=your-instance.clerk.accounts.dev
# Clerk secret key (sk_test_... or sk_live_...). Used only to read a user's email at login.
CLERK_SECRET_KEY=sk_test_replace_me
# Long random string that signs pilot cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECRET=replace_with_random_string
# Folder with allowed-emails.txt, admins.txt and pilot-gate.json (mounted into the container).
CONFIG_DIR=/config
# How long a pilot sign-in lasts, in seconds (28800 = 8 hours).
SESSION_TTL_SECONDS=28800
# Set this only if outbound TLS to Clerk fails behind an interception proxy.
# Mount the host CA bundle at this path too.
SSL_CERT_FILE=/etc/ssl/certs/host-ca-bundle.crt
